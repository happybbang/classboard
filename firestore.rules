rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function paired(uid, sid) {
   return owner(sid) && exists(/databases/$(database)/documents/teacher_data/$(uid)/student_access/$(sid))
    && get(/databases/$(database)/documents/teacher_data/$(uid)/student_access/$(sid)).data.active == true;
  }
  function plan(uid, sid, week) {
   return get(/databases/$(database)/documents/teacher_data/$(uid)/student_access/$(sid)/weeks/$(week)).data;
  }
  function validResult(uid, sid, day) {
   let d = request.resource.data;
   let p = plan(uid, sid, d.week);
   return d.keys().hasOnly(['studentId','week','responses','at'])
    && d.keys().hasAll(['studentId','week','responses','at'])
    && d.studentId == p.studentId && d.week == p.week && day in p.days
    && d.responses is list && d.responses.size() == p.goals.size()
    && d.responses.size() >= 1 && d.responses.size() <= 2
    && d.responses.hasOnly([0,1,2,3]) && d.at is int
    && d.at > 0 && d.at <= request.time.toMillis() + 300000;
  }
  match /teacher_data/{uid}/{document=**} { allow read, write: if owner(uid); }
  match /teacher_data/{uid}/student_access/{sid} {
   allow get: if paired(uid, sid);
   match /weeks/{week} { allow get: if paired(uid, sid); }
   match /checks/{day} {
    allow get: if paired(uid, sid);
    allow create, update: if paired(uid, sid) && validResult(uid, sid, day);
   }
  }
  match /{document=**} { allow read, write: if false; }
 }
}